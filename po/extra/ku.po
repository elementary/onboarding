#: data/io.elementary.onboarding.desktop.in:3
#: data/onboarding.metainfo.xml.in:11
msgid "Welcome"
msgstr "Silav"

#: data/io.elementary.onboarding.desktop.in:4
#: data/onboarding.metainfo.xml.in:12
msgid "Change common settings on first-run"
msgstr "Sazkariyên hevpar di xebitandina yekem de biguhêrîne"

#: data/onboarding.metainfo.xml.in:49
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/onboarding.metainfo.xml.in:58 data/onboarding.metainfo.xml.in:69
#: data/onboarding.metainfo.xml.in:77 data/onboarding.metainfo.xml.in:90
#: data/onboarding.metainfo.xml.in:100 data/onboarding.metainfo.xml.in:112
#: data/onboarding.metainfo.xml.in:129 data/onboarding.metainfo.xml.in:140
#: data/onboarding.metainfo.xml.in:151
msgid "Updated translations"
msgstr "Wergerên rojanekirî"

#: data/onboarding.metainfo.xml.in:88
msgid "Add back button"
msgstr "Bişkoka vegerê tevlî bike"

#: data/onboarding.metainfo.xml.in:89
msgid "Redesign links to match System Settings"
msgstr "Girêdanan ji nû ve dîzayn bike da ku li gorî sazkariyên pergalê be"

#: data/onboarding.metainfo.xml.in:98
msgid "UpdatesView: add OS updates"
msgstr "UpdatesView: rojanekirinên OS tevlî bike"

#: data/onboarding.metainfo.xml.in:99
msgid "Improve screenreader support"
msgstr "Piştgiriya xwînera dîmenderê baştir bike"

#: data/onboarding.metainfo.xml.in:111
msgid "Use the current wallpaper in the \"Choose your look\" view"
msgstr "Wêneya dîwêr a heyî di dîtina \"Xuyanga xwe hilbijêre\" de bi kar bîne"

#: data/onboarding.metainfo.xml.in:124
msgid "Redesigned app icon"
msgstr "Îkona sepanên rojanekirî"

#: data/onboarding.metainfo.xml.in:125
msgid "Generate a main page icon using the default wallpaper and accent color"
msgstr ""
"Bi riya bikaranîna wêneya dîwêr a berdest û rengê taybet îkoneke rûpela "
"sereke biafirîne"

#: data/onboarding.metainfo.xml.in:126
msgid "Use bolder typography"
msgstr "Tipografiya qalindtir bi kar bîne"

#: data/onboarding.metainfo.xml.in:127
msgid "Redesign app page to better explain sideloading and alt stores"
msgstr ""
"Rûpela sepanê ji nû ve dîzayn bike da ku barkirina alî û markêtên alternatîv "
"çêtir werin fêmkirin"

#: data/onboarding.metainfo.xml.in:128
msgid "Always warn about Early Access builds"
msgstr "Her dem derbarê avakirinên gihîştina zû de hişyar bike"

#: data/onboarding.metainfo.xml.in:148
msgid "Add Automatic Updates view"
msgstr "Dîtina rojanekirinên xweber tevlî bike"

#: data/onboarding.metainfo.xml.in:149
msgid "Add Sunset to Sunrise to Style View"
msgstr "Vebijêrka ji rojavabûnê heya rojhelatinê li dîtina şêwazê tevlî bike"

#: data/onboarding.metainfo.xml.in:150
msgid "Update for OS 7 and Gtk 4"
msgstr "Ji bo OS 7 û Gtk 4 rojane bike"

